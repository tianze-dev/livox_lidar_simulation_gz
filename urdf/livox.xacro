<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reusable mount macro: parent owns world, robot_state_publisher and namespaces. -->
  <xacro:include filename="$(find livox_lidar_simulation_gz)/urdf/validation.xacro"/>
  <xacro:macro name="livox_lidar" params="parent name:=mid360 model:=mid360 xyz:='0 0 0' rpy:='0 0 0' points_topic:='' imu_topic:='' visual_mesh:='' mesh_rpy:='0 0 0' namespace:=livox">
    <xacro:livox_require condition="${model in ['mid360', 'avia']}" message="Unsupported Livox model"/>
    <xacro:property name="cfg" value="${xacro.load_yaml('$(find livox_lidar_simulation_gz)/config/models/' + model + '.yaml')}"/>
    <xacro:property name="preset" value="${xacro.load_yaml('$(find livox_lidar_simulation_gz)/dependencies/lock.json')['scan_presets'][model]}"/>
    <xacro:property name="pattern_root" value="$(optenv RGL_PATTERNS_DIR)"/>
    <xacro:property name="default_pattern_root" value="$(find livox_lidar_simulation_gz)/patterns"/>
    <xacro:livox_validate_config cfg="${cfg}" preset="${preset}" model="${model}"/>
    <xacro:livox_check_name value="${name}" first_letter="${True}"/>
    <xacro:livox_require condition="${python.isinstance(namespace,str)}" message="namespace must be a string"/>
    <xacro:if value="${namespace.strip('/') != ''}">
      <xacro:livox_check_segments values="${namespace.strip('/').split('/')}"/>
    </xacro:if>
    <xacro:property name="topic_root" value="${'/' + '/'.join(v for v in [namespace.strip('/'), name] if v)}"/>
    <xacro:property name="actual_points_topic" value="${points_topic or topic_root + '/points'}"/>
    <xacro:property name="actual_imu_topic" value="${imu_topic or topic_root + '/imu'}"/>
    <xacro:livox_check_topic value="${actual_points_topic}"/>
    <xacro:livox_check_topic value="${actual_imu_topic}"/>
    <xacro:livox_require condition="${actual_points_topic != actual_imu_topic}" message="Point cloud and IMU topics must differ"/>
    <xacro:livox_check_vector value="${xyz}" field="xyz"/>
    <xacro:livox_check_vector value="${rpy}" field="rpy"/>
    <xacro:livox_check_vector value="${mesh_rpy}" field="mesh_rpy"/>
    <xacro:property name="sx" value="${cfg['size_x']}"/>
    <xacro:property name="sy" value="${cfg['size_y']}"/>
    <xacro:property name="sz" value="${cfg['size_z']}"/>
    <xacro:property name="actual_mesh" value="${xacro.fatal('Avia primitive appearance has been removed; use the detailed mesh') if model == 'avia' and visual_mesh == 'primitive' else (cfg['visual_mesh'] if visual_mesh == '' else ('' if visual_mesh == 'primitive' else visual_mesh))}"/>
    <!-- Tiny numerical frame masses keep fixed sensor links in Gazebo's URDF conversion. -->
    <xacro:property name="frame_mass" value="0.000001"/>
    <xacro:property name="mass" value="${cfg['mass'] - 2 * frame_mass}"/>
    <link name="${name}_body">
      <inertial>
        <origin xyz="0 0 ${sz / 2}"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass * (sy*sy + sz*sz) / 12}" iyy="${mass * (sx*sx + sz*sz) / 12}" izz="${mass * (sx*sx + sy*sy) / 12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <collision name="${name}_collision">
        <origin xyz="0 0 ${cfg['collision_body_height'] / 2}"/>
        <geometry><box size="${sx} ${sy} ${cfg['collision_body_height']}"/></geometry>
      </collision>
      <!-- Lightweight, model-specific connector envelope; never use CAD for collision. -->
      <xacro:if value="${cfg['connector_collision']}">
      <collision name="${name}_connector_collision">
        <origin xyz="${cfg['connector']['xyz']}" rpy="${cfg['connector']['rpy']}"/>
        <geometry>
          <xacro:if value="${cfg['connector']['shape'] == 'cylinder'}">
            <cylinder radius="${cfg['connector']['radius']}" length="${cfg['connector']['length']}"/>
          </xacro:if>
          <xacro:if value="${cfg['connector']['shape'] == 'box'}">
            <box size="${cfg['connector']['size']}"/>
          </xacro:if>
        </geometry>
      </collision>
      </xacro:if>
    </link>
    <joint name="${name}_mount" type="fixed">
      <parent link="${parent}"/><child link="${name}_body"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="${name}_lidar">
      <inertial><mass value="${frame_mass}"/><inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/></inertial>
      <!-- RGL excludes visuals in the sensor's own link, not the whole robot. -->
      <xacro:if value="${actual_mesh != ''}">
        <visual name="${name}_external_mesh">
          <origin xyz="0 0 ${-cfg['measurement_z']}" rpy="${mesh_rpy}"/>
          <geometry><mesh filename="${actual_mesh}"/></geometry>
        </visual>
      </xacro:if>
      <xacro:unless value="${actual_mesh != ''}">
        <xacro:if value="${cfg['visual_style'] == 'dome'}">
        <visual name="${name}_base_visual">
          <origin xyz="0 0 ${sz * 0.28 - cfg['measurement_z']}"/>
          <geometry><box size="${sx} ${sy} ${sz * 0.56}"/></geometry>
          <material name="${name}_silver"><color rgba="0.65 0.68 0.72 1"/></material>
        </visual>
        <visual name="${name}_cover_visual">
          <origin xyz="0 0 ${sz * 0.76 - cfg['measurement_z']}"/>
          <geometry><cylinder radius="${sx * 0.44}" length="${sz * 0.48}"/></geometry>
          <material name="${name}_blue"><color rgba="0.05 0.23 0.3 1"/></material>
        </visual>
        </xacro:if>
      </xacro:unless>
    </link>
    <joint name="${name}_lidar_joint" type="fixed">
      <parent link="${name}_body"/><child link="${name}_lidar"/>
      <origin xyz="0 0 ${cfg['measurement_z']}"/>
    </joint>
    <link name="${name}_imu">
      <inertial><mass value="${frame_mass}"/><inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${name}_imu_joint" type="fixed">
      <parent link="${name}_body"/><child link="${name}_imu"/>
      <origin xyz="${cfg['imu_xyz'][0]} ${cfg['imu_xyz'][1]} ${cfg['imu_xyz'][2]}"/>
    </joint>
    <gazebo reference="${name}_lidar_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="${name}_imu_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="${name}_lidar">
      <sensor name="${name}_rgl" type="custom">
        <always_on>true</always_on><update_rate>${cfg['lidar_rate']}</update_rate>
        <plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
          <range><min>${cfg['range_min']}</min><max>${cfg['range_max']}</max></range>
          <update_rate>${cfg['lidar_rate']}</update_rate>
          <update_on_paused_sim>false</update_on_paused_sim>
          <topic>${actual_points_topic}</topic><frame>${name}_lidar</frame>
          <pattern_preset_path pattern_count="${preset['pattern_groups']}" rays_per_frame="${preset['rays_per_frame']}">${pattern_root or default_pattern_root}/${preset['pattern_file']}</pattern_preset_path>
        </plugin>
      </sensor>
    </gazebo>
    <gazebo reference="${name}_imu">
      <sensor name="${name}_imu_sensor" type="imu">
        <always_on>true</always_on><update_rate>${cfg['imu_rate']}</update_rate>
        <topic>${actual_imu_topic}</topic><gz_frame_id>${name}_imu</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
