<?xml version="1.0"?>
<sdf version="1.9">
  <world name="parent_world">
    <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="RGLServerPluginManager" name="rgl::RGLServerPluginManager">
      <do_ignore_entities_in_lidar_link>true</do_ignore_entities_in_lidar_link>
    </plugin>
    <model name="wall"><static>true</static><pose>4 0 2 0 0 0</pose>
      <link name="wall">
        <visual name="wall"><geometry><box><size>0.2 8 4</size></box></geometry></visual>
        <collision name="wall"><geometry><box><size>0.2 8 4</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
