<?xml version="1.0"?>
<sdf version="1.9">
  <world name="livox_demo">
    <physics name="step" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="RGLServerPluginManager" name="rgl::RGLServerPluginManager">
      <do_ignore_entities_in_lidar_link>true</do_ignore_entities_in_lidar_link>
    </plugin>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.12 0.14 0.18 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.5 -0.3 -1</direction><diffuse>0.8 0.8 0.8 1</diffuse><cast_shadows>true</cast_shadows></light>
    <model name="floor"><static>true</static><pose>0 0 -0.1 0 0 0</pose><link name="body">
      <collision name="collision"><geometry><box><size>20 20 0.2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>20 20 0.2</size></box></geometry><material><diffuse>0.4 0.45 0.5 1</diffuse></material><laser_retro>20</laser_retro></visual>
    </link></model>
    <model name="front_wall"><static>true</static><pose>4 0 2 0 0 0</pose><link name="body">
      <collision name="collision"><geometry><box><size>0.2 8 4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 8 4</size></box></geometry><material><diffuse>0.8 0.6 0.3 1</diffuse></material><laser_retro>80</laser_retro></visual>
    </link></model>
    <model name="side_box"><static>true</static><pose>-2 3 0.75 0 0 0</pose><link name="body">
      <collision name="collision"><geometry><box><size>1 1 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1 1 1.5</size></box></geometry><material><diffuse>0.2 0.65 0.45 1</diffuse></material><laser_retro>40</laser_retro></visual>
    </link></model>
  </world>
</sdf>
